    },
    {
      "label": "golden_hp",
      "expression": "idleon.callFunction(\"GoldFoodBonuses\", \"MaxHPpct\")",
      "description": "Golden-food maximum-HP multiplier."
    },
    {
      "label": "golden_monster_cash",
      "expression": "idleon.callFunction(\"GoldFoodBonuses\", \"MonsterCash\")",
      "description": "Golden-food coin percentage."
    },
    {
      "label": "golden_skill_exp",
      "expression": "idleon.callFunction(\"GoldFoodBonuses\", \"SkillExp\")",
      "description": "Golden-food skill experience percentage."
    },
    {
      "label": "golden_all_stat_percent",
      "expression": "idleon.callFunction(\"GoldFoodBonuses\", \"AllStatz\")",
      "description": "Golden-food all-stat contribution in raw percentage points, without rounding or division by 100."
    },
    {
      "label": "golden_defence_percent",
      "expression": "idleon.callFunction(\"GoldFoodBonuses\", \"Defence\")",
