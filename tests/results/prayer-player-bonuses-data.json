      "expression": "(() => {\n const attr = key => idleon.engine.getGameAttribute(key);\n const version = idleon.getGameVersion();\n if (version.version !== \"1.22\") throw new Error(\"Prayer replay requires delivered 1.22\");\n const names = attr(\"GetPlayersUsernames\");\n const currentName = attr(\"UserInfo\")[0];\n const targetPlayerId = names.indexOf(currentName);\n if (targetPlayerId !== 3) throw new Error(\"Prayer replay target mismatch\");\n const database = attr(\"PlayerDATABASE\").h;\n const levels = attr(\"PrayersUnlocked\");\n const definitions = attr(\"CustomLists\").h.PrayerInfo;\n const prepared = attr(\"DNSM\").h;\n const bits = {};\n for (const id of [9,39,53]) {\n  bits[id] = Number(idleon.callFunction(\"GamingStatType\",\"SuperBitType\",id,0));\n  if (!Number.isFinite(bits[id])) throw new Error(\"Missing native Superbit \"+id);\n }\n const passiveActive = bits[9] === 1 || bits[39] === 1;\n const passiveFraction = 0.2 * bits[9] + (0.2 * bits[39] + 0.2 * bits[53]);\n const ordinaryBonuses = {}, prayerInputs = {};\n for (const id of [7,5,16]) {\n  if (!definitions[id] || levels[id] === undefined) throw new Error(\"Missing initialized Prayer \"+id);\n  const base = Number(definitions[id][3]), level = Number(levels[id]);\n  if (!Number.isFinite(base) || !Number.isFinite(level)) throw new Error(\"Non-finite Prayer input \"+id);\n  const levelMultiplier = Math.max(1,1+(level-1)/10);\n  prayerInputs[id] = {base,level,levelMultiplier};\n  ordinaryBonuses[id] = Math.round(base * levelMultiplier);\n }\n const players = names.map((name,playerId) => {\n  if (!database[name]) throw new Error(\"Missing native character record \"+name);\n  const rawSlots = database[name].h.Prayers;\n  if (rawSlots !== undefined && !Array.isArray(rawSlots)) throw new Error(\"Unexpected native Prayer slots \"+name);\n  const slotCount = rawSlots === undefined ? 0 : rawSlots.length;\n  // Fresh source predicate: an empty raw list never reaches the final empty-slot match.\n  const noEquippedPrayers = slotCount > 0 && rawSlots.every(slot => slot == -1);\n  const bonuses = {};\n  for (const id of [7,5,16]) {\n   const input = prayerInputs[id];\n   if (!passiveActive || !noEquippedPrayers) {\n    bonuses[id] = rawSlots !== undefined && rawSlots.indexOf(id) !== -1 ? ordinaryBonuses[id] : 0;\n   } else {\n    bonuses[id] = id !== 5 && input.level > 0.5\n     ? Math.round(passiveFraction * input.base * input.levelMultiplier) : 0;\n   }\n  }\n  return {playerId,playerName:name,rawSlots:rawSlots === undefined ? null : rawSlots,slotCount,noEquippedPrayers,bonuses};\n });\n return {\n  context:{version,targetPlayerId,targetPlayerName:currentName},bits,passiveActive,passiveFraction,\n  prayerInputs,ordinaryBonuses,players,\n  cachedNoEquippedDiagnostic:Object.prototype.hasOwnProperty.call(prepared,\"PrayNonEq\") ? prepared.PrayNonEq : null\n };\n})()",
